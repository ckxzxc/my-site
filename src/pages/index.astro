---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import {pageSchema} from '../content.config.ts'
import { getEntry } from 'astro:content';

//const homepage = (await getCollection('pages')).find((page) => page.id === '/');
const getHomepage = await getEntry('pages', 'index');

const homepage = getHomepage?.data;



const parsedPage = pageSchema.parse(homepage)
---

<BaseLayout title={parsedPage.title ? parsedPage.title: ''} description={parsedPage.description ? parsedPage.description: ''}>
   
   <PageLayout page={parsedPage}></PageLayout>

</BaseLayout>
