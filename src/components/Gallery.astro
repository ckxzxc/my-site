---
import {Image} from 'astro:assets';
import type {Gallery} from '../content.config';
import {componentGapClasses} from '../lib/classes';
import {getImage} from '../lib/utils/image';

interface Props {
    gallery: Gallery;
}
const {gallery} = Astro.props;


const columnClasses = {
  '1': 'grid-cols-1 sm:grid-cols-2',
  '2': 'grid-cols-2',
} as const;

const maxColumnClasses = {
  '2': '',
  '3': 'md:grid-cols-3',
  '4': 'md:grid-cols-3 lg:grid-cols-4',
} as const;

const ratioClasses = {
  '3/4': 'aspect-3/4',
  '4/3': 'aspect-4/3',
  '1/1': 'aspect-1/1',
} as const;


---
<div class:list={componentGapClasses[gallery.gap]}>
  <div class:list={[
    "grid gap-1",
    columnClasses[gallery.minColumns],
    maxColumnClasses[gallery.maxColumns],
  ]}>
    {  
        gallery.images.map((galleryImage) => {
          const image = getImage(galleryImage.path);

          return (
            <figure> 
                <Image
                  src={image!}
                  alt={galleryImage.alt}
                  loading="lazy"
                  class:list={[
                    'w-full',
                    ratioClasses[gallery.ratio],
                    {'object-contain p-item-sm sm:p-item': gallery.display === 'contain'},
                    {'object-cover': gallery.display === 'cover'},
                  ]}
                />
            </figure>
          );
        })
    }
  </div>
</div>