---
import type {Accordion} from '../content.config';
import {componentGapClasses} from '../lib/classes';
interface Props {
    accordion: Accordion;
}
const {accordion} = Astro.props;
---

    <div class:list={[
        componentGapClasses[accordion.gap],
        'flex flex-col gap-item-sm'
    ]}>
        {       
            accordion?.items?.map((item, index) => (
                item.title && item.text &&
                <div class="w-full collapse collapse-arrow border border-current/30">
                    <input type="radio" name={accordion.name} checked={index === 0} />
                    <div class="collapse-title text-base font-semibold">{item.title}</div>
                    <div class="collapse-content text-base w-full">{item.text}</div>
                </div>
            ))           
        }
    </div>
